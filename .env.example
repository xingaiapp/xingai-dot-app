# Contact form (/api/contact) — Resend delivery. Without RESEND_API_KEY the
# form returns an honest error and never fakes "Message sent".
RESEND_API_KEY=
CONTACT_TO_EMAIL=contact@xingai.app
# Must be a Resend-verified sender. Example after domain verify:
# CONTACT_FROM_EMAIL=XingAI Contact <noreply@xingai.app>
CONTACT_FROM_EMAIL=
