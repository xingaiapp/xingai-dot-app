{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "github": {
    "silent": true
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.xingai.app" }],
      "destination": "https://xingai.app/:path*",
      "permanent": true
    }
  ]
}
